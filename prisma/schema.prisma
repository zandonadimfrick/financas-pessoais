// Schema do sistema de finanças pessoais
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Escopo {
  PF
  PJ
}

enum TipoConta {
  CORRENTE
  POUPANCA
  INVESTIMENTO
  CARTEIRA
}

enum TipoLancamento {
  ENTRADA
  SAIDA
}

enum Periodicidade {
  DIARIA
  SEMANAL
  MENSAL
  ANUAL
}

enum StatusRecebivel {
  PENDENTE
  RECEBIDO
  ATRASADO
  CANCELADO
}

enum StatusFatura {
  ABERTA
  FECHADA
  PAGA
}

enum TipoDocumento {
  NOTA_FISCAL
  COMPROVANTE
  OUTRO
}

model Account {
  id            String        @id @default(cuid())
  nome          String
  instituicao   String
  tipo          TipoConta     @default(CORRENTE)
  escopo        Escopo        @default(PF)
  saldoInicial  Float         @default(0)
  cor           String        @default("#6366f1")
  icone         String?
  arquivada     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  transactions  Transaction[]
  cards         Card[]
  recurrings    Recurring[]
}

model Card {
  id              String        @id @default(cuid())
  nome            String
  instituicao     String
  escopo          Escopo        @default(PF)
  limite          Float         @default(0)
  diaFechamento   Int           @default(1)
  diaVencimento   Int           @default(10)
  cor             String        @default("#a855f7")
  arquivado       Boolean       @default(false)
  accountId       String?
  account         Account?      @relation(fields: [accountId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  transactions    Transaction[]
  invoices        CardInvoice[]
  recurrings      Recurring[]
}

/**
 * Fatura de um ciclo do cartão.
 *
 * As compras NÃO guardam o id da fatura: a que pertencem é derivada da data
 * da compra e do dia de fechamento do cartão. Assim, mudar o fechamento
 * reorganiza os ciclos sem precisar corrigir lançamento por lançamento.
 * Esta tabela guarda só o que não dá pra derivar: se a fatura foi paga.
 */
model CardInvoice {
  id            String       @id @default(cuid())
  cardId        String
  card          Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)

  /** Mês de referência do fechamento, no formato "AAAA-MM". */
  competencia   String
  fechamento    DateTime
  vencimento    DateTime

  status        StatusFatura @default(ABERTA)
  pagoEm        DateTime?
  valorPago     Float?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([cardId, competencia])
  @@index([cardId])
}

model Category {
  id            String        @id @default(cuid())
  nome          String        @unique
  tipo          TipoLancamento
  essencial     Boolean       @default(false)
  cor           String        @default("#22d3ee")
  icone         String?
  createdAt     DateTime      @default(now())

  transactions  Transaction[]
  recurrings    Recurring[]
  spendingLimit SpendingLimit?
}

model Transaction {
  id            String          @id @default(cuid())
  descricao     String
  valor         Float
  tipo          TipoLancamento
  data          DateTime
  escopo        Escopo          @default(PF)
  observacao    String?
  efetivado     Boolean         @default(true)

  categoryId    String?
  category      Category?       @relation(fields: [categoryId], references: [id])

  accountId     String?
  account       Account?        @relation(fields: [accountId], references: [id])

  cardId        String?
  card          Card?           @relation(fields: [cardId], references: [id])

  recurringId   String?
  recurring     Recurring?      @relation(fields: [recurringId], references: [id])

  /*
    Parcelamento. Uma compra em N vezes vira N lançamentos — um por ciclo de
    fatura, cada um com o valor da parcela. Assim cada fatura mostra só o que
    é devido nela, enquanto a soma das parcelas ainda não pagas segura o
    limite do cartão por inteiro, como num banco de verdade.

    `compraId` é o mesmo em todas as parcelas de uma compra, e permite
    editá-las ou excluí-las como um bloco.
  */
  compraId      String?
  parcela       Int?
  parcelasTotal Int?
  /** Valor cheio da compra parcelada — guardado para não recalcular por soma. */
  valorTotal    Float?

  documents     Document[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([data])
  @@index([tipo])
  @@index([escopo])
  @@index([compraId])
}

model Recurring {
  id              String          @id @default(cuid())
  nome            String
  valor           Float
  tipo            TipoLancamento  @default(SAIDA)
  periodicidade   Periodicidade   @default(MENSAL)
  diaCobranca     Int             @default(1)
  escopo          Escopo          @default(PF)
  ativo           Boolean         @default(true)
  proximaCobranca DateTime?

  categoryId      String?
  category        Category?       @relation(fields: [categoryId], references: [id])

  /*
    Onde a assinatura é cobrada. Saber que ela cai no cartão é o que permite
    mostrar, na tela de cartões, quanto do limite some todo mês só com
    mensalidades — que é a pergunta que o extrato sozinho não responde.
  */
  cardId          String?
  card            Card?           @relation(fields: [cardId], references: [id])

  accountId       String?
  account         Account?        @relation(fields: [accountId], references: [id])

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  transactions    Transaction[]
}

model Receivable {
  id            String          @id @default(cuid())
  descricao     String
  valor         Float
  vencimento    DateTime
  status        StatusRecebivel @default(PENDENTE)
  escopo        Escopo          @default(PF)
  pagador       String?
  observacao    String?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

/**
 * Teto de gastos mensal POR CATEGORIA ("no máximo R$ 250 de Uber no mês").
 * Serve de alerta na barra lateral — é referência, não trava: o sistema nunca
 * impede um lançamento por causa dele.
 */
model SpendingLimit {
  id         String   @id @default(cuid())
  categoryId String   @unique
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  valor      Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Document {
  id            String        @id @default(cuid())
  tipo          TipoDocumento @default(COMPROVANTE)
  nomeArquivo   String
  caminho       String
  mimeType      String
  tamanho       Int
  escopo        Escopo        @default(PF)
  competencia   String
  observacao    String?

  transactionId String?
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])

  createdAt     DateTime      @default(now())
}
